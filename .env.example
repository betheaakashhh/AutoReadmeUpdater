# ── GitHub App credentials ──────────────────────────────────────────────────
# From https://github.com/settings/apps → your app's settings page
APP_ID=
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=

# ── Behaviour ────────────────────────────────────────────────────────────────
# Path to the README file to update (useful for monorepos)
README_PATH=README.md

# If true (default): only repo owner / admin pushes trigger auto-commits.
# Everyone else's changes only land after a PR review is approved.
STRICT_OWNER_ONLY=true

PORT=3000
