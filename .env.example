# --- GitHub App credentials (from https://github.com/settings/apps) ---
APP_ID=
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=

# --- AI provider (Anthropic Claude by default) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Behavior config ---
# Path to the README file to keep in sync (supports monorepos: docs/README.md, packages/x/README.md, etc.)
README_PATH=README.md

# If true (default), only direct pushes from the repo owner/admin auto-commit.
# Everyone else's changes only land after a PR review is approved.
STRICT_OWNER_ONLY=true

# Local server port (Probot default is 3000)
PORT=3000
